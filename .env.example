# Configure no Netlify (escopo Functions/Runtime). Não use NEXT_PUBLIC_.
R4_PASSWORD=
# Senha exclusiva da liderança, mínimo 12 caracteres, diferente da senha de membros.
R4_SESSION_SECRET=
# Chave aleatória com no mínimo 32 caracteres para assinar sessões de 8 horas.
GOOGLE_SHEETS_SCRIPT_URL=
GOOGLE_SHEETS_SCRIPT_TOKEN=

# Obrigatória para membros: 12 a 256 caracteres, comparação exata. Não há senha padrão.
MEMBERS_PASSWORD=
# Opcional: usa R4_SESSION_SECRET quando não definido, com assinatura de membro separada.
MEMBERS_SESSION_SECRET=
